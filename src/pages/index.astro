---
import Base from '../layouts/Base.astro';
import { company } from '../data/company';
import { getCatalog, href } from '../data/catalog';

const catalog = await getCatalog();

const fabrics = [
  { title: 'Кулирка', text: 'Лёгкая и воздушная хлопковая материя. Хорошо держит форму, прочная и износостойкая.' },
  {
    title: 'Интерлок',
    text: 'Трикотажное полотно высокой плотности. Мягкий материал хорошо впитывает влагу и пропускает воздух. Для изготовления тёплой одежды используется интерлок с начёсом.',
  },
  { title: 'Футер', text: 'Мягкий, тёплый материал с гладкой лицевой и петлеобразной/ворсистой изнаночной стороной.' },
  { title: 'Велюр', text: 'Натуральный материал с мягким ворсом, обладающий красивым блеском.' },
];

const offers = [
  'Качественную продукцию',
  'Низкие цены без посреднических наценок',
  'Минимальную сумму заказа 5000 рублей. Это позволяет Вам проверить качество нашей продукции при минимальных затратах',
  'Бесплатную доставку товара до терминалов транспортных компаний',
];

const carriers = [
  { title: 'Деловые линии', url: 'https://www.dellin.ru/' },
  { title: 'Байкал Сервис', url: 'https://www.baikalsr.ru/' },
  { title: 'ТК Кит', url: 'https://spare.tk-kit.com/' },
  { title: 'ПЭК', url: 'https://pecom.ru/' },
  { title: 'ЖелДорЭкспедиция', url: 'https://www.jde.ru/' },
  { title: 'CDEK', url: 'https://www.cdek.ru/ru/' },
  { title: 'CARGO-EXPRESS', url: 'https://cargo-express.ru/' },
];
---

<Base>
  <div class="container">
    <section class="hero card">
      <div class="hero__text">
        <h1>Производство одежды из&nbsp;трикотажа</h1>
        <p class="hero__lead">
          {company.legalName} — это производство по пошиву женского, мужского и детского трикотажа. На производстве
          используются современные пошивочные машинки, которые обеспечивают высокое качество продукции.
        </p>
        <p>
          Мы предлагаем домашнюю и повседневную трикотажную одежду на все случаи жизни, одежду для спорта и активного
          отдыха. Модели изготавливаются из приятных к телу натуральных тканей лучшего качества. В основе каждого полотна
          преобладает хлопок, который обеспечивает высокие гигиенические свойства.
        </p>
        <div class="hero__actions">
          <a class="btn btn--accent" href={href('/woman/')}>Смотреть каталог</a>
          <a class="btn" href={company.priceUrl} target="_blank" rel="noopener">Прайс-лист</a>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Каталог</h2>
      <div class="sections-grid">
        {
          catalog.map((section) => (
            <div class="section-tile card">
              <h3>
                <a href={href(`/${section.slug}/`)}>{section.title}</a>
              </h3>
              <div class="chips">
                {section.categories.map((category) => (
                  <a class="chip" href={href(`/${section.slug}/${category.slug}/`)}>
                    {category.data.title}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <h2>Ткани для пошива</h2>
      <div class="fabrics">
        {
          fabrics.map((fabric) => (
            <div class="fabric card">
              <h3>{fabric.title}</h3>
              <p>{fabric.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <h2>Мы предлагаем Вам</h2>
      <ul class="offers">
        {offers.map((offer) => <li class="card">{offer}</li>)}
      </ul>
    </section>

    <section class="section order card">
      <div>
        <h2>Как заказать</h2>
        <p>Вы можете сделать заказ удобным для Вас способом. Менеджер свяжется с Вами для уточнения заказа.</p>
        <p class="order__contacts">
          <a href={company.phoneHref}>{company.phone}</a>
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </p>
        <a class="btn btn--accent" href={company.priceUrl} target="_blank" rel="noopener">Прайс ООО «Альбатрос»</a>
      </div>
      <div>
        <h3>Рассчитать стоимость доставки можно на сайтах транспортных компаний:</h3>
        <div class="chips">
          {
            carriers.map((carrier) => (
              <a class="chip" href={carrier.url} target="_blank" rel="noopener">
                {carrier.title}
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding: clamp(24px, 5vw, 56px);
    background:
      radial-gradient(circle at 100% 0%, rgb(255 204 0 / 0.35), transparent 45%),
      var(--card);
  }

  .hero__text {
    max-width: 760px;
  }

  .hero__lead {
    font-size: 1.15rem;
    color: var(--ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .section-tile {
    padding: 24px;
    border-top: 4px solid var(--accent);
  }

  .section-tile h3 a {
    text-decoration: none;
  }

  .section-tile h3 a:hover {
    text-decoration: underline;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--bg);
    font-size: 14px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .chip:hover {
    background: var(--accent);
  }

  .fabrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .fabric {
    padding: 24px;
  }

  .fabric p {
    margin: 0;
    color: var(--muted);
  }

  .offers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    counter-reset: offer;
  }

  .offers li {
    padding: 20px 24px;
    counter-increment: offer;
  }

  .offers li::before {
    content: counter(offer);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-bottom: 12px;
    border-radius: 50%;
    background: var(--accent);
    font-weight: 700;
    color: var(--ink);
  }

  .order {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding: clamp(24px, 4vw, 40px);
  }

  .order__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-weight: 600;
  }

  .order__contacts a {
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .order {
      grid-template-columns: 1fr;
    }
  }
</style>
