---
import { Image, getImage } from 'astro:assets';
import type { Category } from '../data/catalog';

interface Props {
  product: Category['data']['products'][number];
}

const { product } = Astro.props;
// Полноразмерные фото для просмотра в увеличенном виде
const full = await Promise.all(
  product.images.map((image) => getImage({ src: image, width: Math.min(image.width, 1200), format: 'webp' })),
);
const alt = `${product.title}, артикул ${product.sku}`;
// В ряду миниатюр 5 ячеек: если фото больше, последняя показывает «+N»
const THUMBS = 5;
const thumbs = product.images.length > THUMBS ? product.images.slice(0, THUMBS - 1) : product.images;
const rest = product.images.length - thumbs.length;
---

<article class="product card" id={`sku-${product.sku}`}>
  {
    product.images.length > 0 ? (
      <div class="product__gallery" data-gallery={JSON.stringify(full.map((image) => image.src))}>
        <a class="product__main" href={full[0].src} data-index="0">
          <Image src={product.images[0]} alt={alt} widths={[360, 540, 720]} sizes="(max-width: 600px) 100vw, 360px" />
          {product.images.length > 1 && <span class="product__more">{product.images.length} фото</span>}
        </a>
        {product.images.length > 1 ? (
          <div class="product__thumbs">
            {thumbs.map((image, index) => (
              <a href={full[index].src} data-index={index} aria-label={`Фото ${index + 1}`}>
                <Image src={image} alt="" width={72} height={96} densities={[1, 2]} />
              </a>
            ))}
            {rest > 0 && (
              <a href={full[thumbs.length].src} data-index={thumbs.length} class="product__rest" aria-label="Все фото">
                +{rest}
              </a>
            )}
          </div>
        ) : (
          <div class="product__thumbs" aria-hidden="true">
            <span class="product__spacer" />
          </div>
        )}
      </div>
    ) : (
      <div>
        <div class="product__nophoto">Фото временно отсутствуют</div>
        <div class="product__thumbs" aria-hidden="true">
          <span class="product__spacer" />
        </div>
      </div>
    )
  }
  <div class="product__info">
    <span class="product__sku">Артикул {product.sku}</span>
    <h2 class="product__title">{product.title}</h2>
    <dl>
      {
        product.material && (
          <>
            <dt>Материал</dt>
            <dd>{product.material}</dd>
          </>
        )
      }
      {
        product.sizes && (
          <>
            <dt>Размеры</dt>
            <dd>{product.sizes}</dd>
          </>
        )
      }
    </dl>
  </div>
</article>

<style>
  .product {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .product__main {
    position: relative;
    display: block;
    cursor: zoom-in;
  }

  .product__main img,
  .product__nophoto {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--line);
  }

  .product__nophoto {
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: 14px;
  }

  .product__more {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(22 24 29 / 0.75);
    color: #fff;
    font-size: 13px;
  }

  .product__thumbs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    padding: 8px 10px 0;
  }

  /* Пустая ячейка держит высоту ряда миниатюр, чтобы артикулы в ряду карточек стояли на одной линии */
  .product__spacer,
  .product__thumbs a {
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid transparent;
  }

  .product__thumbs a:hover {
    border-color: var(--accent);
  }

  .product__thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Одна колонка карточек (сетка minmax(260px) + отступы): выравнивать не с чем */
  @media (max-width: 583px) {
    .product__thumbs[aria-hidden] {
      display: none;
    }
  }

  .product__rest {
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .product__info {
    padding: 14px 18px 18px;
  }

  .product__sku {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }

  .product__title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 10px 0 8px;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 12px;
    margin: 0;
    font-size: 14px;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
  }
</style>
